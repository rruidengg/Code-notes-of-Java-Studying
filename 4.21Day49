42.接雨水
暴力解法最简单 但是超时
class Solution {
    public int trap(int[] height) {
         int sum = 0;//记录总接水量
         for (int i = 0;i< height.length;i ++){
            if (i == 0 || i == height.length - 1) continue;//第一个和最后一个不接水
            int rHeight = height[i]; // 记录右边柱子的最高高度
            int lHeight = height[i]; // 记录左边柱子的最高高度

         for (int r = i+1; r < height.length; r++) {
                if (height[r] > rHeight) rHeight = height[r];//寻找i右边最高柱子
            }
        for (int l = i-1; l >= 0; l--) {
                if(height[l] > lHeight) lHeight = height[l];//寻找i左边最高柱子
            }
        int h = Math.min(lHeight, rHeight) - height[i];
            if (h > 0) sum += h;
         }
         return sum;
    }
}

双指针法：
class Solution {
    public int trap(int[] height) {
         int sum = 0;//记录总接水量
     if (height.length <= 2) {
            return 0;
            }

            int maxLeft = height[0], maxRight = height[height.length - 1];//双指针
            int l = 1, r = height.length - 2;
             while (l <= r) {
            // 不确定上一轮是左边移动还是右边移动，所以两边都需更新最值
            maxLeft = Math.max(maxLeft, height[l]);
            maxRight = Math.max(maxRight, height[r]);
            if (maxLeft < maxRight) {
                sum += maxLeft - height[l ++];
            } else {
               sum += maxRight - height[r --];
            }
        }   return sum;      
    }   
}


84.柱状图中最大矩形 
暴力解法容易理解
class Solution {
    public int largestRectangleArea(int[] heights) {
        int length = heights.length;
        int[] minLeftIndex = new int [length];
        int[] minRightIndex = new int [length];
        // 记录左边第一个小于该柱子的下标
        minLeftIndex[0] = -1 ;
        for (int i = 1; i < length; i++) {
            int t = i - 1;
            // 这里不是用if，而是不断向右寻找的过程
            while (t >= 0 && heights[t] >= heights[i]) t = minLeftIndex[t];
            minLeftIndex[i] = t;
        }
        // 记录每个柱子右边第一个小于该柱子的下标
        minRightIndex[length - 1] = length;
        for (int i = length - 2; i >= 0; i--) {
            int t = i + 1;
            while(t < length && heights[t] >= heights[i]) t = minRightIndex[t];
            minRightIndex[i] = t;
        }
        // 求和
        int result = 0;
        for (int i = 0; i < length; i++) {
            int sum = heights[i] * (minRightIndex[i] - minLeftIndex[i] - 1);
            result = Math.max(sum, result);
        }
        return result;
    }
}
