//144 二叉树前序递归遍历（简单）
class Solution {
    public List<Integer> preorderTraversal(TreeNode root) { 
        List <Integer> res = new ArrayList<Integer>();//创建一个 ArrayList 用来保存遍历结果。
        preorder(root, res); // 调用递归函数 preorder() 进行遍历。
        return res; //返回前序遍历结果列表
    }

    public void preorder (TreeNode root, List<Integer> res){
        if(root==null){
            return;
        }
        res.add(root.val);//将当前节点的值加入结果列表。
        preorder (root.left,res);
        preorder (root.right,res);
    }
}

//144 二叉树前序迭代遍历
class Solution {
    public List<Integer> preorderTraversal(TreeNode root) {
        List <Integer> res = new ArrayList<Integer>();
        preorder(root, res);
        return res;
    }

    public void preorder (TreeNode root, List<Integer> res){
        if(root==null){
            return;
        }
        Deque<TreeNode> stack = new LinkedList<>();//创建一个 双端队列 Deque，用作 栈（Stack）--先进后出 。
        stack.push(root);//把根节点压入栈。
        while (!stack.isEmpty()) {//只要栈 不为空，就继续遍历。
            TreeNode temp = stack.poll(); //取出栈顶节点。
            res.add(temp.val); //把当前节点的值加入结果列表。
            if (temp.right != null) { //先压入右子节点。
                stack.push(temp.right);
            }
            if (temp.left != null) {
                stack.push(temp.left);
            }
        }
    }
}



//层序遍历
// 102 二叉树层序遍历
class Solution {
    public List<List<Integer>> levelOrder(TreeNode root) {
         List<List<Integer>> ret = new ArrayList<List<Integer>>();//创建一个二维列表
         if (root == null) {
            return ret;
        }

     Queue<TreeNode> queue = new LinkedList<TreeNode>(); //创建 队列 Queue。
        queue.offer(root); //将根节点加入队列。
    while (!queue.isEmpty()) {
            List<Integer> level = new ArrayList<Integer>();//创建列表，用于存储 当前层所有节点值。
            int currentLevelSize = queue.size(); //当前层有多少个节点
            for (int i = 1; i <= currentLevelSize; ++i) { //循环 currentLevelSize 次。
                TreeNode node = queue.poll(); //取出并删除队头元素
                level.add(node.val); //把节点值加入当前层列表。
                if (node.left != null) {
                    queue.offer(node.left);
                }
                if (node.right != null) {
                    queue.offer(node.right);
                }
            }
            ret.add(level);
        }
        
        return ret;
    }
   }

